# =============================================================================
# Kyrpy UI/UX Designer — Optional Server-Side PostgreSQL Credentials Template
# =============================================================================
# Copy to `credentials.env` or `.env` (or run `./install.sh`).
# Never commit `credentials.env` or `.env` to version control.
# =============================================================================

export PG_SYNC_ENABLED="false"
export PGHOST="your-postgres-host.example.com"
export PGPORT="5432"
export PGUSER="postgres"
export PGPASSWORD="your-postgres-password-placeholder"
export PGDATABASE="kyrpy-uiux-designer-db"
export PGADMINDB="postgres"
