{
  "name": "kyrpy-uiux-designer",
  "version": "2.0.0",
  "private": true,
  "description": "SQLite-backed UI/UX app designer: icon, item, screen and workflow libraries with themeable, animatable SVG and HTML/CSS/TS/JS export.",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning main.js serve",
    "import": "node --disable-warning=ExperimentalWarning main.js import",
    "reset": "node --disable-warning=ExperimentalWarning main.js import --reset",
    "export": "node --disable-warning=ExperimentalWarning main.js export",
    "guide": "node --disable-warning=ExperimentalWarning main.js guide",
    "db:publish": "node --disable-warning=ExperimentalWarning scripts/publish-from-pg.js",
    "db:export-public": "node --disable-warning=ExperimentalWarning scripts/export-public-db.js",
    "icons:import": "node --disable-warning=ExperimentalWarning scripts/import-icon-packs.js",
    "icons:online": "node --disable-warning=ExperimentalWarning scripts/import-online-sets.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js mcp/tests/*.test.js"
  }
}
