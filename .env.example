# =============================================================================
# Kyrpy UI/UX Designer — Environment Configuration (.env)
# =============================================================================
# Copy this file to `.env` (or run `./install.sh` to configure interactively).
# By default, the app uses its built-in offline-first SQLite database
# (`src/data/designer.db`) and works 100% locally with zero external services.
# =============================================================================

# HTTP Server Port
PORT=5180

# Mode: Set PG_SYNC_ENABLED=true and fill in PostgreSQL credentials below to
# enable bi-directional synchronization with a remote PostgreSQL server.
# Set PG_SYNC_ENABLED=false (or leave PGHOST empty) for Local-Only SQLite mode.
PG_SYNC_ENABLED=false
LOCAL_ONLY=true

# Optional Server-Side PostgreSQL Connection Settings (Placeholders)
PGHOST=your-postgres-host.example.com
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-postgres-password-placeholder
PGDATABASE=kyrpy-uiux-designer-db
PGADMINDB=postgres
