# ============================================================================
# Kyrpy UI/UX Designer — Sample Environment & Credentials Configuration (.env)
# ============================================================================
# Copy this file to `.env` or run `./installer.sh` (Linux/macOS) / `.\installer.ps1` (Windows)
# to generate `.env` interactively.
#
# By default, Kyrpy UI/UX Designer runs 100% locally using the bundled SQLite
# database (`src/data/designer.db`). Server-side PostgreSQL synchronization is
# completely optional.
# ============================================================================

# --- 1. Local HTTP Studio Server ---
PORT=5180
HOST=127.0.0.1

# --- 2. Authentication & Runtime Mode (dev vs release) ---
# APP_MODE=dev     -> Bypasses the Login/Register gate for rapid local development
# APP_MODE=release -> Protects the studio page with the Login/Register gate
APP_MODE=dev
BYPASS_AUTH=true

# Default Startup Installer Account (seeded automatically on first boot)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin

# --- 3. Local SQLite Database Path (Optional override) ---
# UD_DB_PATH=./src/data/designer.db

# --- 4. Optional Server-Side PostgreSQL Synchronization (Placeholders Only) ---
# Leave PGHOST empty or PG_SYNC_ENABLED=false / LOCAL_ONLY=true to run strictly
# on your local machine with SQLite (offline-first).
PG_SYNC_ENABLED=false
LOCAL_ONLY=true
PGHOST=your-postgres-host.example.com
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-postgres-password-placeholder
PGDATABASE=kyrpy-uiux-designer-db
PGADMINDB=postgres
PG_SSL=false
