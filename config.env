# config.env — Application Configuration for kyrpy-uiux-designer
export SERVICE_NAME="kyrpy-uiux-designer"
export SERVICE_PORT="${SERVICE_PORT:-5180}"
export SERVICE_SUBDOMAIN="${SERVICE_SUBDOMAIN:-designer}"
export SERVICE_TYPE="local"
export DEPLOYMENT_NAMESPACE="default"
export STARTUP_CMD="node --disable-warning=ExperimentalWarning src/main.js serve --port ${SERVICE_PORT:-5180}"
export LOG_FILE="./logs/app.log"
export PID_FILE="./logs/app.pid"

# Server configuration
export PORT="${PORT:-5180}"

# Load local untracked .env or credentials.env if present
if [[ -f "$(dirname "${BASH_SOURCE[0]}")/.env" ]]; then
  source "$(dirname "${BASH_SOURCE[0]}")/.env"
fi
if [[ -f "$(dirname "${BASH_SOURCE[0]}")/credentials.env" ]]; then
  source "$(dirname "${BASH_SOURCE[0]}")/credentials.env"
fi

# PostgreSQL Sync Configuration (offline-first local SQLite + optional remote PostgreSQL)
# Leave PGHOST empty or set PG_SYNC_ENABLED=false to run 100% locally with SQLite only.
export PG_SYNC_ENABLED="${PG_SYNC_ENABLED:-false}"
export PGHOST="${PGHOST:-}"
export PGPORT="${PGPORT:-5432}"
export PGUSER="${PGUSER:-postgres}"
export PGPASSWORD="${PGPASSWORD:-}"
export PGDATABASE="${PGDATABASE:-kyrpy-uiux-designer-db}"
export PGADMINDB="${PGADMINDB:-postgres}"
