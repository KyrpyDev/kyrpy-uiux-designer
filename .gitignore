# ==============================================================================
# Kyrpy UI/UX Designer — Strict Repository Whitelist (.gitignore)
# ==============================================================================
# Ignore everything by default except the explicitly whitelisted public files:
#   - src/
#   - sql/
#   - config/
#   - README.md, CONTRIBUTING.md, LICENSE
#   - .env.example
#   - installer.sh, installer.ps1, runner.sh, runner.ps1
# ==============================================================================

/*
!/.gitignore
!/.env.example
!/credentials.env.example
!/README.md
!/CONTRIBUTING.md
!/LICENSE
!/installer.sh
!/installer.ps1
!/runner.sh
!/runner.ps1
!/config/
!/sql/
!/src/

# Private VM / Local Scripts & Credentials (NEVER pushed)
run.sh
install.sh
.env
.env.*
!.env.example
credentials.env
*.pem
*.key

# Node / Runtime / Temporary Artifacts inside whitelisted folders
node_modules/
src/node_modules/
src/data/*.db-shm
src/data/*.db-wal
src/data/*.db-journal
*.log
*.pid
.designer-runner.pid
.DS_Store
